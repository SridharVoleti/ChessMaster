    "inventory_completeness": "initial_discovery"
  },
  "summary": {
    "objective": "Discover every positional concept required for a complete chess education.",
    "scope": "Position evaluation, pawn structures, piece activity, space, key squares, files, diagonals, colour complexes and positional imbalances.",
