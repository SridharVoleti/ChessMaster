# Supabase — public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side only, NEVER expose to client
SUPABASE_SERVICE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=

# BabySteps → ChessMaster browser handoff (POST /launch)
# See CHESSMASTER_LAUNCH_INTEGRATION.md. All provisioned by BabySteps at onboarding and
# handed over through a secure channel — never commit real values. Server-side only.
# Generate a dev Ed25519 keypair:
#   node -e "const {publicKey,privateKey}=require('crypto').generateKeyPairSync('ed25519');console.log('APP_LAUNCH_SIGNING_PRIVATE_KEY='+JSON.stringify(privateKey.export({format:'jwk'})));console.log('# public (give to BabySteps): '+JSON.stringify(publicKey.export({format:'jwk'})));"
APP_LAUNCH_CLIENT_ID=
APP_LAUNCH_SIGNING_PRIVATE_KEY=
APP_LAUNCH_BOOTSTRAP_SECRET=            # 32+ char HS256 shared secret
APP_LAUNCH_APP_ID=
APP_LAUNCH_ENVIRONMENT=
APP_LAUNCH_DEPLOYMENT_ID=
# Optional — defaults shown
# APP_LAUNCH_EXCHANGE_URL=https://www.babystepsindia.com/v1/internal/app-launch/exchange
# APP_LAUNCH_BOOTSTRAP_ISSUER=https://babysteps.in
# APP_LAUNCH_RETURN_URL=https://www.babystepsindia.com
# APP_LAUNCH_LANDING_PATH=/play/fork

# Authz (Postgres auth + booked-day session quota)
# REQUIRED: Postgres connection string for the `chessmaster` schema (auth tables).
# Use the Supabase *transaction* pooler (port 6543) — it is built for serverless.
#   Supabase dashboard → Project Settings → Database → Connection string → "Transaction"
AUTHZ_DATABASE_URL=
# The rest are optional, defaults shown:
# AUTHZ_ENFORCE=1                # gate /play behind an active session (off unless set to 1)
# AUTHZ_SESSIONS_PER_DAY=2
# AUTHZ_SESSION_MINUTES=45
# AUTHZ_TOKEN_TTL_HOURS=336
# AUTHZ_MAX_ADVANCE_DAYS=30
# AUTHZ_PASSWORD_MIN_LENGTH=8
# AUTHZ_TIME_ZONE=Asia/Kolkata   # day boundaries for bookings; default = server time zone

# Python pipeline — local machine only, never deployed
# (same as SUPABASE_SERVICE_KEY above, repeated for pipeline scripts)
SUPABASE_URL=
