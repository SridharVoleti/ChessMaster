# Supabase — public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side only, NEVER expose to client
SUPABASE_SERVICE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=

# Authz (SQLite auth + booked-day session quota) — all optional, defaults shown
# AUTHZ_DB_PATH=data/authz.sqlite
# AUTHZ_ENFORCE=1                # gate /play behind an active session (off unless set to 1)
# AUTHZ_SESSIONS_PER_DAY=2
# AUTHZ_SESSION_MINUTES=45
# AUTHZ_TOKEN_TTL_HOURS=336
# AUTHZ_MAX_ADVANCE_DAYS=30
# AUTHZ_PASSWORD_MIN_LENGTH=8
# AUTHZ_TIME_ZONE=Asia/Kolkata   # day boundaries for bookings; default = server time zone

# Python pipeline — local machine only, never deployed
# (same as SUPABASE_SERVICE_KEY above, repeated for pipeline scripts)
SUPABASE_URL=
